{
  "manifest_version": 3,
  "name": "Custom Dashboard",
  "version": "1.0",
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline'; object-src 'self'"
  },
  "host_permissions": [
    "file:///*",
    "https://api.open-meteo.com/*"
  ]
}